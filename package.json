{
  "name": "fillin-monorepo",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "12.9.1"
  },
  "scripts": {
    "build": "turbo run build",
    "release:extension": "turbo run build --filter=@fillin/extension && node scripts/stage-extension.mjs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@fillin/extension",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\""
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@12.9.1"
}
